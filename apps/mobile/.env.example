# Copy to apps/mobile/.env.local and fill in. EXPO_PUBLIC_ values are built into the app; OAuth client ids
# aren't secret. Restart `npm run mobile` (and rebuild the dev app for the iOS one) after changing them.

# The same Web client id as the web app's VITE_GOOGLE_CLIENT_ID, from the same Google Cloud project, so the
# phone and the website see the same Ascent files in Drive. Android also needs an Android OAuth client in that
# project (see README), but its id isn't used here: Google matches the app's package name and signing key.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# An iOS OAuth client (bundle id com.omeedthomas.ascent) in the same project. Only needed for iPhone builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Development only: fake Google accounts whose "Drive" is stored on the device, to try syncing without Google.
EXPO_PUBLIC_CLOUD_MOCK=false
