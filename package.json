{
  "name": "ascent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "mobile": "npm run start -w @ascent/mobile",
    "dev": "npm run dev -w @ascent/web",
    "dev:lan": "npm run dev:lan -w @ascent/web",
    "build": "npm run build -w @ascent/web",
    "preview": "npm run preview -w @ascent/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:videos": "node scripts/check-videos.mjs"
  }
}
